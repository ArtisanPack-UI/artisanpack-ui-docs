meta {
  name: Import documentation
  type: http
  seq: 7
}

post {
  url: {{base_url}}/api/v1/packages/:package/import-docs
  body: none
  auth: bearer
}

params:path {
  package: 1
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{token}}
}

docs {
  Requires the `imports:trigger` ability. `:package` is the numeric id or the package slug. Queues an import from `docs_url` (preferred) or `wiki_url` and returns 202; 422 when neither is set.
}
