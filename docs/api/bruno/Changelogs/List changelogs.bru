meta {
  name: List changelogs
  type: http
  seq: 1
}

get {
  url: {{base_url}}/api/v1/packages/:package/changelogs
  body: none
  auth: bearer
}

params:path {
  package: 1
}

headers {
  Accept: application/json
}

auth:bearer {
  token: {{token}}
}

docs {
  Requires the `changelogs:read` ability. Newest-first.
}
